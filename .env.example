# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values. .env.local is gitignored
# and must never be committed.
# ---------------------------------------------------------------------------

# REQUIRED. Resend API key. Create one at https://resend.com/api-keys with
# "Sending access" only — it does not need full access.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# REQUIRED. The From address on both emails. The domain must be verified in
# Resend first (see README for the DNS records), otherwise every send is
# rejected. A display name is optional but makes the inbox friendlier.
INQUIRY_FROM="Rohit Shrestha Studio <studio@rohitshrestha.photo>"

# OPTIONAL. Where enquiry notifications land. Defaults to site.email from
# src/data/site.ts. Set this if you read enquiries somewhere other than the
# address published on the site.
# INQUIRY_TO=enquiries@rohitshrestha.photo

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------

# OPTIONAL. Submissions allowed per IP per window. Default 5.
# Raise this temporarily when you need to submit repeatedly while testing —
# there is no x-forwarded-for header locally, so every local submission shares
# one key and you will hit the limit quickly.
# RATE_LIMIT_MAX=5

# OPTIONAL. Length of the sliding window in minutes. Default 60.
# RATE_LIMIT_WINDOW_MINUTES=60

# OPTIONAL but strongly recommended once deployed to serverless. Without these
# the rate limit is held in each instance's memory, so the effective limit is
# multiplied by the number of running instances. With them it is shared and
# exact. Create a free database at https://console.upstash.com — no SDK needed,
# the REST endpoint is called directly.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxx

# ---------------------------------------------------------------------------
# Testing only
# ---------------------------------------------------------------------------

# Forces a send to fail, so you can see the error state without breaking
# anything. Ignored when NODE_ENV=production, so it cannot be left on by
# accident.
#   INQUIRY_FORCE_FAIL=1             fails the notification — the enquiry fails
#   INQUIRY_FORCE_FAIL=confirmation  fails only the courtesy email to the
#                                    enquirer; the enquiry itself still succeeds
# INQUIRY_FORCE_FAIL=1

# Prints both composed emails to the terminal instead of sending them. Use this
# while rewriting the copy in src/data/emails.ts. Also ignored in production.
# INQUIRY_DRY_RUN=1

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------

# OPTIONAL. Your site's domain, exactly as registered with Plausible, e.g.
# rohitshrestha.photo. Leave unset and no analytics script is loaded at all.
# No cookies, no personal data, so no consent banner is required.
# NEXT_PUBLIC_ANALYTICS_DOMAIN=rohitshrestha.photo

# ---------------------------------------------------------------------------
# Enquiry storage (optional)
# ---------------------------------------------------------------------------

# OPTIONAL. Postgres connection string. Without it the notification email is the
# only record of an enquiry — delete the email and it is gone. With it, every
# enquiry is also written to a table, so a Resend outage or a deleted email no
# longer loses a booking, and `npm run inquiries` can list them.
#
# Free tier at https://neon.tech — copy the pooled connection string.
# The table is created automatically on first use.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
